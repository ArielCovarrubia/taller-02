# Variables de la Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taller02_db
POSTGRES_PORT=5432

# URL de conexión interna para la API
DATABASE_URL=postgresql://postgres:postgres@db:5432/taller02_db?schema=public

# Puerto donde correrá la API
APP_PORT=3000

COMPOSE_PROFILES=dev